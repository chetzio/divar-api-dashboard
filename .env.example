# Copy this file to web/.env and worker/.env (both are gitignored). Keep them in sync -
# each workspace's dev server only reads its own .env, not this root one.
#
# Use an absolute path here - relative "file:./prisma/dev.db" resolves inconsistently
# across web/ and worker/ since npm runs each workspace's scripts from its own folder.
DATABASE_URL="file:/absolute/path/to/radiokar/prisma/dev.db"

# Only needed by worker/ (the Telegram bot, Phase 2). Get this from @BotFather.
# Leave empty for Phase 1 - the worker runs fine without it, email/SMS notify instead.
TELEGRAM_BOT_TOKEN=""

# SMTP creds used to SEND alert emails (an infra credential, like DATABASE_URL -
# not the destination address, which is a Setting field editable from /settings).
# Needed in BOTH web/.env (for the "send test email" button on /settings, which
# runs as a Next.js Server Action) and worker/.env (for the actual alert loop).
# Easiest zero-cost option: an existing Gmail account + an App Password
# (myaccount.google.com/apppasswords), not your regular Gmail password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
